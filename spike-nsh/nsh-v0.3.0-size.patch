diff -ruN -x target -x Cargo.lock a/crates/nsh-core/src/svg_stub.rs b/crates/nsh-core/src/svg_stub.rs
--- a/crates/nsh-core/src/svg_stub.rs	1969-12-31 16:00:00
+++ b/crates/nsh-core/src/svg_stub.rs	2026-10-28 12:52:22
@@ -0,0 +1,56 @@
+//! BENCH ONLY: the `svg` API with no resvg behind it. Nothing is sniffed as SVG.
+use std::fmt;
+
+use crate::geometry::{DevicePixels, Points, Size};
+
+#[derive(Debug, Clone, PartialEq, Default)]
+#[non_exhaustive]
+pub struct Raster {
+    pub width: u32,
+    pub height: u32,
+    pub pixels: Vec<u8>,
+    pub size: Size<Points>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+#[non_exhaustive]
+pub enum Error {
+    Disabled,
+}
+
+impl fmt::Display for Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("SVG support is not built in")
+    }
+}
+
+impl std::error::Error for Error {}
+
+pub fn sniff(_bytes: &[u8]) -> bool {
+    false
+}
+
+pub fn size(_bytes: &[u8]) -> Result<Size<Points>, Error> {
+    Err(Error::Disabled)
+}
+
+pub fn reported_size(size: Size<Points>) -> Size<DevicePixels> {
+    let whole = |p: Points| DevicePixels(p.0.round().clamp(1.0, i32::MAX as f32) as i32);
+    Size::new(whole(size.width), whole(size.height))
+}
+
+pub fn rasterize(_bytes: &[u8], _max_px: u32) -> Result<Raster, Error> {
+    Err(Error::Disabled)
+}
+
+pub fn rasterize_covering(_bytes: &[u8], _px: u32) -> Result<Raster, Error> {
+    Err(Error::Disabled)
+}
+
+pub fn rasterize_scaled(_bytes: &[u8], _scale: f32) -> Result<Raster, Error> {
+    Err(Error::Disabled)
+}
+
+pub fn rasterize_oversampled(_bytes: &[u8]) -> Result<Raster, Error> {
+    Err(Error::Disabled)
+}
